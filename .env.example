# Exchange and market
EXCHANGE=binance
SYMBOL=BTC/USDT

# Market maker loop
POLL_INTERVAL_SEC=2
QUOTE_SPREAD_BPS=30
QUOTE_SIZE=0.001
MAX_POSITION_BASE=0.01
LOOP_ENABLED=true
METRICS_ENABLED=true
MARKET_DATA_MODE=poll

# Storage (use DATABASE_URL for Postgres in Docker)
DB_URL=sqlite:///./data/mm_lab.db
# DATABASE_URL=postgresql://mmlab:mmlab@localhost:5432/mmlab

# Fees (basis points) — keep maker fee well below spread for a coherent paper demo
MAKER_FEE_BPS=2
TAKER_FEE_BPS=5

# Fill simulation: full_cross_fill | partial_fill | latency_prob_fill
FILL_MODE=full_cross_fill
FILL_LATENCY_TICKS=2
FILL_PROBABILITY=0.7

# Strategy: pure_mm | inventory_skew | volatility_spread
STRATEGY=pure_mm

# Paper trading capital
INITIAL_QUOTE_BALANCE=10000
MAX_POSITION_NOTIONAL=1000
REPORT_INTERVAL_TICKS=5

FIXTURE_FALLBACK_ENABLED=true
# MARKET_DATA_FIXTURE_PATH=tests/fixtures/orderbook_snapshots.csv

# Optional shared secret for mutating operator routes (kill switch). Leave unset for local DX.
# OPERATOR_API_TOKEN=change-me

# DEX comparison (V2)
DEX_ENABLED=true
ETH_RPC_URL=https://ethereum.publicnode.com
DEX_POOL_ADDRESS=0xB4e16d0168e52d35CaCD2c6185b44281Ec28C9Dc
CEX_COMPARE_SYMBOL=ETH/USDT
AMM_FEE_BPS=30
ARBITRAGE_TRIAL_TRADE_SIZE=0.1
ARBITRAGE_MIN_EDGE_BPS=5
GAS_LIMIT_UNITS=200000
GAS_PRICE_GWEI=30
INVENTORY_TARGET_BASE=0
INVENTORY_SKEW_BPS=20

# Volatility spread strategy
VOLATILITY_WINDOW=20
VOLATILITY_SPREAD_MULTIPLIER=1.0

# Uniswap V3 pool reader (read-only). Uses ETH_RPC_URL; no API key required.
# A free-tier provider URL (Alchemy/Infura) may replace ETH_RPC_URL for reliability.
V3_ENABLED=true
V3_POOL_ADDRESS=0x88e6A0c2dDD26FEEb64F039a2c41296FcB3f5640
V3_WINDOW_WORDS=2
V3_WINDOW_REFRESH_TICKS=15
# Optional archive-capable URL, only used by scripts/backfill_v3.py. Treated as a secret.
# ETH_ARCHIVE_RPC_URL=

# Paper concentrated-liquidity LP book (separate capital from the CEX book)
LP_ENABLED=true
LP_CAPITAL_QUOTE=10000
LP_RANGE_WIDTH_BPS=200
LP_REBALANCE_THRESHOLD_BPS=80
LP_REBALANCE_COOLDOWN_SEC=300
LP_REBALANCE_GAS_UNITS=450000
LP_PRIORITY_FEE_GWEI=0.05
LP_PREFER_INITIALIZED_TICKS=true
LP_SNAP_TOLERANCE_SPACINGS=3

# Flash-arbitrage simulation (specs/003-flash-arb). Read-only: every simulation is an
# eth_call with temporary state overrides. Nothing is ever signed or sent, and no key exists.
ARB_SIM_ENABLED=true
# Optional separate RPC for simulations. It must serve the same chain and block numbers as
# ETH_RPC_URL (simulations run at the V3 snapshot's block). For a local anvil fork, point
# ETH_RPC_URL itself at anvil instead. Defaults to ETH_RPC_URL; treated as a secret.
# ARB_SIM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<free-key>
ARB_SIM_EVERY_TICKS=1
ARB_REFERENCE_SIZE_QUOTE=1000
ARB_GAS_UNITS=160000
ARB_PRIORITY_FEE_GWEI=0.05
ARB_SIM_SUBSIDY_QUOTE=1000000
ARB_SIM_TIMEOUT_SEC=10

# Mempool watcher (specs/004-mempool-watcher). Read-only: follows pending transactions on the
# free keyless publicnode websocket, predicts swaps on the V2/V3 WETH/USDC pools and verifies
# them against each block. Never signs or sends. Both URLs are treated as secrets.
MEMPOOL_ENABLED=true
# auto (live, falling back to block replay) | live | replay
MEMPOOL_MODE=auto
# Also replay each block's swaps while live, labeled separately (no extra RPC calls)
MEMPOOL_REPLAY_ALONGSIDE=true
# MEMPOOL_WS_URL=wss://ethereum-rpc.publicnode.com
# MEMPOOL_RPC_URL=  (defaults to ETH_RPC_URL)
MEMPOOL_RESOLVE_BLOCKS=5
MEMPOOL_LIVE_GRACE_SEC=300
MEMPOOL_CALL_BUDGET_PER_BLOCK=25
MEMPOOL_RETENTION_DAYS=7

# Binance spot testnet trader (specs/005-binance-testnet-execution). Fake money only: orders go
# to testnet.binance.vision, which is fixed in code. Free keys: https://testnet.binance.vision
# (GitHub login). Put them in .env (git-ignored), never in this file. Without keys the trader
# stays off and the dashboard shows a recorded session.
TESTNET_ENABLED=true
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
TESTNET_POLL_INTERVAL_SEC=2
# TESTNET_QUOTE_SPREAD_BPS=  (defaults to QUOTE_SPREAD_BPS)
# TESTNET_QUOTE_SIZE=        (defaults to QUOTE_SIZE)
TESTNET_INITIAL_BASE=0
TESTNET_REPLACE_THRESHOLD_BPS=2
TESTNET_RECONCILE_INTERVAL_SEC=30
